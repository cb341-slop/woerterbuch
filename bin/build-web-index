#!/usr/bin/env bash
set -euo pipefail

# Usage: bin/build-web-index [DATABASE] [OUTPUT]

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATABASE="${1:-$ROOT/word_index/lookup.sqlite3}"
OUTPUT="${2:-$ROOT/word_index/web-index.js}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "usage: bin/build-web-index [DATABASE] [OUTPUT]"
    exit 0
fi

if [ "$#" -gt 2 ]; then
    echo "usage: bin/build-web-index [DATABASE] [OUTPUT]" >&2
    exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found. Install Python 3 to build the browser index." >&2
    exit 1
fi

if [ ! -f "$DATABASE" ]; then
    echo "database not found: $DATABASE" >&2
    echo "run bin/update-sqlite first" >&2
    exit 1
fi

PYTHONDONTWRITEBYTECODE=1 exec python3 "$ROOT/scripts/build_web_index.py" \
    "$DATABASE" "$OUTPUT" "$ROOT/etymwb-headwords.json"
